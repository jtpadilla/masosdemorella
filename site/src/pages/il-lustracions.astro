---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { figures, figuresEdicio, href, slugOf, titolCurt } from '../lib/llibre';

const imatges = import.meta.glob<ImageMetadata>('../../../assets/images/*.{jpg,svg}', { eager: true, import: 'default' });
const nota: Record<string, string> = { '01-mapa-dels-ports.svg': 'Redibuixat per a esta edició' };
const perFitxer = Object.fromEntries(Object.entries(imatges).map(([k, v]) => [k.split('/').pop()!, v]));
const figs = await figures();
const perdudes = figs.filter((f) => !f.file).length;
---
<Base title="Il·lustracions">
  <h1>Il·lustracions</h1>
  <p>Les {figs.length} fotografies del llibre, en l'ordre en què apareixen. {perdudes > 0 ? `${perdudes} d'elles ja no estaven dins del PDF conservat i s'han perdut. ` : 'Quatre d\'elles (Dalla, Carrejador, Trill i Garbells) no eren dins del PDF i les ha aportat la família. '}Totes són de l'autora i del seu arxiu familiar. Cada imatge enllaça amb el fitxer a resolució original.</p>
  <ul class="galeria">
    {figs.map((f) => (
      <li>
        <figure>
          {f.file ? (
            <a href={perFitxer[f.file].src} title="Obri la imatge a resolució original">
              <Image src={perFitxer[f.file]} alt={f.caption} width={640} layout={f.file.endsWith('.svg') ? 'none' : undefined} />
            </a>
          ) : (
            <div class="perduda-mini">Il·lustració perduda</div>
          )}
          <figcaption>
            <span class="num">{f.n}</span>{f.caption}
            <a class="on" href={href(`${slugOf(f.capitol)}/`)}>{titolCurt(f.capitol.data.title)}{f.file && nota[f.file] ? ` · ${nota[f.file]}` : ''}</a>
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>

  <h2 id="edicio">Il·lustracions d'esta edició</h2>
  <p>Estes imatges no eren en el llibre original: s'han fet per a esta edició digital i es presenten a banda per no confondre-les amb les fotografies de l'autora. Més detalls en <a href={href('edicio/')}>Sobre esta edició</a>.</p>
  <ul class="galeria">
    {figuresEdicio.map((f) => (
      <li>
        <figure>
          <a href={perFitxer[f.file].src} title="Obri la imatge a mida completa">
            <Image src={perFitxer[f.file]} alt={f.caption} width={640} layout={f.file.endsWith('.svg') ? 'none' : undefined} />
          </a>
          <figcaption>{f.caption}<span class="on">{f.note}</span></figcaption>
        </figure>
      </li>
    ))}
  </ul>
</Base>
<style is:global>main { width: min(100% - 2.5rem, 60rem); }</style>
